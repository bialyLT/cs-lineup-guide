# URL base de la API REST de Django (Django REST Framework)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Client ID de "Sign in with Google" (OAuth 2.0 de Google Cloud Console).
# Copiá el mismo valor que GOOGLE_CLIENT_ID del backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID.apps.googleusercontent.com