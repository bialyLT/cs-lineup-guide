# URL base de la API REST de Django (Django REST Framework)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Client ID de "Sign in with Google" (OAuth 2.0 de Google Cloud Console).
# Copiá el mismo valor que GOOGLE_CLIENT_ID del backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# Producción (Vercel). En el panel de Vercel → Settings → Environment Variables:
#
# NEXT_PUBLIC_API_URL=https://<backend.up.railway.app>/api
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=<mismo client id que en desarrollo>
#
# Además, en Google Cloud Console → Credenciales OAuth agregá el origen de
# producción (https://<tu-dominio.vercel.app>) en "Orígenes de JavaScript
# autorizados".
# ---------------------------------------------------------------------------