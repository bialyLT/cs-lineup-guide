# Copiá a .env y ajustá según tu entorno.
# Sin DATABASE_URL se usa SQLite (desarrollo sin PostgreSQL).

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (Django REST Framework / backend)
DATABASE_URL=postgres://lineuplab:lineuplab@localhost:5432/lineuplab

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cliente de OAuth 2.0 (Sign in with Google). Dejalo vacío para deshabilitarlo.
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com

# Cloudflare R2 (imágenes de mapas y quizzes).
# Sin credenciales, los uploads de imágenes quedan deshabilitados.
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET_NAME=cslineupsguide
R2_ENDPOINT_URL=https://97c0b5f961934c102e3b4b8eb9277f0d.r2.cloudflarestorage.com
# URL pública base para servir las imágenes (dominio r2.dev o custom).
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Email (verificación de cuentas).
# Sin EMAIL_HOST se usa el backend de consola: el correo y el código se
# imprimen en la terminal de Django (ideal para desarrollo).
# FRONTEND_URL se usa en el botón "Verificar mi email" del correo.
FRONTEND_URL=http://localhost:3000
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=LineupLab <no-reply@lineuplab.app>

# ---------------------------------------------------------------------------
# Producción (Railway). Copiá estas variables en el panel de Railway:
#
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=<clave larga y aleatoria, ej: openssl rand -hex 48>
# DATABASE_URL=<tu Postgres, por ejemplo el de Neon que ya usás>
# DJANGO_ALLOWED_HOSTS=<dominio del backend>,<dominio propio si tenés>
# CORS_ALLOWED_ORIGINS=https://<frontend.vercel.app>
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<backend.up.railway.app>
# GOOGLE_CLIENT_ID=<mismo client id, con el origen de producción autorizado
#                   en Google Cloud Console / Credenciales OAuth>
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET_NAME / R2_ENDPOINT_URL /
# R2_PUBLIC_URL  → los mismos valores que en desarrollo.
# FRONTEND_URL=https://<frontend.vercel.app>
# EMAIL_HOST / EMAIL_PORT / EMAIL_HOST_USER / EMAIL_HOST_PASSWORD /
# EMAIL_USE_TLS / DEFAULT_FROM_EMAIL → datos de tu proveedor SMTP
# (p. ej. Resend, SendGrid, Mailgun o el SMTP del proveedor de correo).
#
# Railway agrega RAILWAY_PUBLIC_DOMAIN solo: no hace falta incluirlo en
# DJANGO_ALLOWED_HOSTS.
# ---------------------------------------------------------------------------